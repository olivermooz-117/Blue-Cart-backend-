DATABASE_URL=
SECRET_KEY=
JWT_SECRET_KEY=
FLASK_ENV=

# RapidAPI keys (used for Amazon & AliExpress wrappers).
# Each site defaults to the shared RAPIDAPI_KEY but can be overridden.
RAPIDAPI_KEY=
RAPIDAPI_AMAZON_KEY=
RAPIDAPI_ALIEXPRESS_KEY=
RAPIDAPI_AMAZON_HOST=real-time-amazon-data.p.rapidapi.com
RAPIDAPI_ALIEXPRESS_HOST=aliexpress-datahub.p.rapidapi.com

# eBay Browse API (OAuth2 client-credentials). Optional until approved.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Prices are converted from USD to KES using this rate.
USD_TO_KES_RATE=130

# Search-result cache TTL in seconds (default 12 min, within 10-15 min window).
SEARCH_CACHE_TTL_SECONDS=720

# Per-IP rate limiting on the search endpoint (requests per window).
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Rate limiter storage backend (default memory://). Example: redis://localhost:6379/0
RATELIMIT_STORAGE_URI=

# JWT access token lifetime in seconds (default 86400 = 24 hours).
JWT_ACCESS_TOKEN_EXPIRES=86400

# Allowed CORS origins (comma separated; defaults to localhost dev + Vercel frontend).
CORS_ORIGINS=http://localhost:5173,https://blue-cart-frontend.vercel.app

# Optional Redis URL for shared search-result caching and rate limiting.
# When unset (or Redis unavailable), the in-memory cache is used.
# Example: REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# Optional: per-site cash-on-delivery defaults (site-level, not live API data).
PAY_ON_DELIVERY_AMAZON=false
PAY_ON_DELIVERY_ALIEXPRESS=false
PAY_ON_DELIVERY_EBAY=false
